(define (domain plotting)

  (:requirements
    :strips
    :typing
    :equality
    :universal-preconditions
    :existential-preconditions
    :conditional-effects
    :disjunctive-preconditions
    :negative-preconditions
    :fluents)

  ; ===========================================================================
  ; Balanced "best-of-both" model, WITHOUT precompiled action geometry.
  ;
  ; Numeric state:
  ;   colour-of(cell) = 0 empty, >=1 real colour id
  ;   hand-colour     = -1 wildcard, >=1 real colour id
  ;   colour-id(c)    = stable positive id for each real colour
  ;
  ; Geometry remains part of the planning model: row/col comparisons plus sparse
  ; static adjacency and border predicates.  No row-prefix/waterfall-copy/etc.
  ; facts are generated by the converter.
  ; ===========================================================================

  (:types cell colour)

  (:predicates
    (above ?upper ?lower - cell)
    (right ?left ?right-cell - cell)

    (istoprow    ?c - cell)
    (islastcol   ?c - cell)
    (isbottomrow ?c - cell)

    (blockedrow ?c - cell)
    (blockedcol ?c - cell)
  )

  (:functions
    (row ?c - cell)
    (col ?c - cell)

    (colour-id ?c - colour)
    (colour-of ?c - cell)
    (hand-colour)
    (total-block)
  )

  (:action shoot-row
    :parameters (?last - cell ?c - colour)
    :precondition
      (and
        (not (blockedrow ?last))
        (> (colour-id ?c) 0)

        (or (= (hand-colour) (colour-id ?c))
            (< (hand-colour) 0))

        (forall (?x - cell)
          (or
            (not (= (row ?x) (row ?last)))
            (> (col ?x) (col ?last))
            (= (colour-of ?x) (colour-id ?c))
            (= (colour-of ?x) 0)))

        (exists (?x - cell)
          (and
            (= (row ?x) (row ?last))
            (<= (col ?x) (col ?last))
            (= (colour-of ?x) (colour-id ?c))))

        (or
          (islastcol ?last)
          (exists (?b - cell)
            (and
              (right ?last ?b)
              (> (colour-of ?b) 0)
              (not (= (colour-of ?b) (colour-id ?c)))))))

    :effect
      (and
        (forall (?x - cell)
          (when
            (and
              (= (row ?x) (row ?last))
              (<= (col ?x) (col ?last))
              (= (colour-of ?x) (colour-id ?c)))
            (decrease (total-block) 1)))

        (forall (?lo ?up - cell)
          (when
            (and
              (above ?up ?lo)
              (> (row ?lo) 1)
              (<= (row ?lo) (row ?last))
              (<= (col ?lo) (col ?last)))
            (assign (colour-of ?lo) (colour-of ?up))))

        (forall (?t - cell)
          (when
            (and
              (istoprow ?t)
              (<= (col ?t) (col ?last)))
            (assign (colour-of ?t) 0)))

        (forall (?b - cell)
          (when
            (and
              (not (islastcol ?last))
              (right ?last ?b)
              (> (colour-of ?b) 0)
              (not (= (colour-of ?b) (colour-id ?c))))
            (and
              (assign (hand-colour) (colour-of ?b))
              (assign (colour-of ?b) (colour-id ?c)))))

        (when
          (islastcol ?last)
          (assign (hand-colour) (colour-id ?c)))))

  (:action shoot-column
    :parameters (?last - cell ?c - colour)
    :precondition
      (and
        (not (blockedcol ?last))
        (> (colour-id ?c) 0)

        (or (= (hand-colour) (colour-id ?c))
            (< (hand-colour) 0))

        (= (colour-of ?last) (colour-id ?c))

        (forall (?x - cell)
          (or
            (not (= (col ?x) (col ?last)))
            (> (row ?x) (row ?last))
            (= (colour-of ?x) (colour-id ?c))
            (= (colour-of ?x) 0)))

        (or
          (isbottomrow ?last)
          (exists (?b - cell)
            (and
              (above ?last ?b)
              (> (colour-of ?b) 0)
              (not (= (colour-of ?b) (colour-id ?c)))))))

    :effect
      (and
        (forall (?x - cell)
          (when
            (and
              (= (col ?x) (col ?last))
              (<= (row ?x) (row ?last))
              (= (colour-of ?x) (colour-id ?c)))
            (and
              (assign (colour-of ?x) 0)
              (decrease (total-block) 1))))

        (forall (?b - cell)
          (when
            (and
              (not (isbottomrow ?last))
              (above ?last ?b)
              (> (colour-of ?b) 0)
              (not (= (colour-of ?b) (colour-id ?c))))
            (and
              (assign (hand-colour) (colour-of ?b))
              (assign (colour-of ?b) (colour-id ?c)))))

        (when
          (isbottomrow ?last)
          (assign (hand-colour) (colour-id ?c)))))

  (:action shoot-row-and-column
    :parameters (?row-end ?last - cell ?c - colour)
    :precondition
      (and
        (islastcol ?row-end)
        (islastcol ?last)
        (> (row ?last) (row ?row-end))
        (> (colour-id ?c) 0)

        (not (blockedrow ?row-end))
        (not (blockedcol ?last))

        (or (= (hand-colour) (colour-id ?c))
            (< (hand-colour) 0))

        (forall (?x - cell)
          (or
            (not (= (row ?x) (row ?row-end)))
            (= (colour-of ?x) (colour-id ?c))
            (= (colour-of ?x) 0)))

        (forall (?x - cell)
          (or
            (not (islastcol ?x))
            (<= (row ?x) (row ?row-end))
            (> (row ?x) (row ?last))
            (= (colour-of ?x) (colour-id ?c))
            (= (colour-of ?x) 0)))

        (exists (?x - cell)
          (and
            (= (colour-of ?x) (colour-id ?c))
            (or
              (= (row ?x) (row ?row-end))
              (and
                (islastcol ?x)
                (> (row ?x) (row ?row-end))
                (<= (row ?x) (row ?last))))))

        (or
          (isbottomrow ?last)
          (exists (?b - cell)
            (and
              (above ?last ?b)
              (> (colour-of ?b) 0)
              (not (= (colour-of ?b) (colour-id ?c)))))))

    :effect
      (and
        (forall (?x - cell)
          (when
            (and
              (= (row ?x) (row ?row-end))
              (= (colour-of ?x) (colour-id ?c)))
            (decrease (total-block) 1)))

        (forall (?x - cell)
          (when
            (and
              (islastcol ?x)
              (> (row ?x) (row ?row-end))
              (<= (row ?x) (row ?last))
              (= (colour-of ?x) (colour-id ?c)))
            (decrease (total-block) 1)))

        (forall (?lo ?up - cell)
          (when
            (and
              (not (islastcol ?lo))
              (above ?up ?lo)
              (> (row ?lo) 1)
              (<= (row ?lo) (row ?row-end)))
            (assign (colour-of ?lo) (colour-of ?up))))

        (forall (?t - cell)
          (when
            (and
              (not (islastcol ?t))
              (istoprow ?t))
            (assign (colour-of ?t) 0)))

        (forall (?d - cell)
          (when
            (and
              (islastcol ?d)
              (<= (row ?d) (+ (- (row ?last) (row ?row-end)) 1)))
            (assign (colour-of ?d) 0)))

        (forall (?d ?s - cell)
          (when
            (and
              (islastcol ?d)
              (islastcol ?s)
              (<= (row ?d) (row ?last))
              (> (row ?d) (+ (- (row ?last) (row ?row-end)) 1))
              (= (row ?s)
                 (- (row ?d) (+ (- (row ?last) (row ?row-end)) 1))))
            (assign (colour-of ?d) (colour-of ?s))))

        (forall (?b - cell)
          (when
            (and
              (not (isbottomrow ?last))
              (above ?last ?b)
              (> (colour-of ?b) 0)
              (not (= (colour-of ?b) (colour-id ?c))))
            (and
              (assign (hand-colour) (colour-of ?b))
              (assign (colour-of ?b) (colour-id ?c)))))

        (when
          (isbottomrow ?last)
          (assign (hand-colour) (colour-id ?c)))))
)
